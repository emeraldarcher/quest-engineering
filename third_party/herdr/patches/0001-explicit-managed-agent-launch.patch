+#[test]
+fn agent_start_explicit_command_bypasses_path_and_preserves_literal_argv() {
+    use std::os::unix::fs::PermissionsExt;
+
+    let _lock = test_lock();
+    let base = unique_test_dir();
+    let config_home = base.join("config");
+    let runtime_dir = base.join("runtime");
+    let socket_path = runtime_dir.join("herdr.sock");
+    fs::create_dir_all(&base).unwrap();
+    let absolute_base = fs::canonicalize(&base).unwrap();
+    let bin = absolute_base.join("bin");
+    let explicit_cwd = fs::canonicalize(std::env::current_dir().unwrap()).unwrap();
+    let record = absolute_base.join("explicit-record");
+    let trap_record = absolute_base.join("path-trap-record");
+    fs::create_dir_all(&bin).unwrap();
+
+    let path_trap = bin.join("pi");
+    fs::write(
+        &path_trap,
+        format!(
+            "#!/bin/sh\nprintf invoked > '{}'\nexit 99\n",
+            trap_record.display()
+        ),
+    )
+    .unwrap();
+    fs::set_permissions(&path_trap, fs::Permissions::from_mode(0o755)).unwrap();
+
+    let explicit = absolute_base.join("explicit-agent");
+    fs::write(
+        &explicit,
+        format!(
+            "#!/bin/sh\n{{\nprintf 'cwd=<%s>\\n' \"$PWD\"\nprintf 'env=<%s>\\n' \"$EXPLICIT_ENV\"\nprintf 'managed-kind=<%s>\\n' \"$HERDR_AGENT\"\nprintf 'size=<%s>\\n' \"$(/bin/stty size)\"\ni=0\nfor arg in \"$@\"; do printf 'arg[%s]=<%s>\\n' \"$i\" \"$arg\"; i=$((i+1)); done\n}} > '{}'\n\"$HERDR_BIN_PATH\" pane report-agent \"$HERDR_PANE_ID\" --source test:explicit-agent --agent pi --state idle >/dev/null\nwhile IFS= read -r prompt; do\n  printf 'prompt=<%s>\\n' \"$prompt\" >> '{}'\n  \"$HERDR_BIN_PATH\" pane report-agent \"$HERDR_PANE_ID\" --source test:explicit-agent --agent pi --state working >/dev/null\n  \"$HERDR_BIN_PATH\" pane report-agent \"$HERDR_PANE_ID\" --source test:explicit-agent --agent pi --state idle >/dev/null\ndone\n",
+            record.display(),
+            record.display(),
+        ),
+    )
+    .unwrap();
+    fs::set_permissions(&explicit, fs::Permissions::from_mode(0o755)).unwrap();
+
+    let hostile_path = PathBuf::from(format!("{}:/usr/bin:/bin", bin.display()));
+    let child = spawn_herdr_with_path(
+        &config_home,
+        &runtime_dir,
+        &socket_path,
+        Some(&hostile_path),
+    );
+    wait_for_socket(&socket_path, Duration::from_secs(5));
+    let workspace = send_request(
+        &socket_path,
+        &serde_json::json!({
+            "id": "explicit_workspace",
+            "method": "workspace.create",
+            "params": { "cwd": base.display().to_string(), "focus": false }
+        })
+        .to_string(),
+    );
+    let pane_id = workspace["result"]["root_pane"]["pane_id"]
+        .as_str()
+        .unwrap()
+        .to_string();
+
+    let literal_args = serde_json::json!([
+        "foo bar",
+        "'single' and \"double\"",
+        "$(touch should-not-exist)",
+        "*.rs; echo not-a-command",
+        "snowman ☃",
+        ""
+    ]);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let started = loop {
+        let response = send_request(
+            &socket_path,
+            &serde_json::json!({
+                "id": "explicit_start",
+                "method": "agent.start",
+                "params": {
+                    "name": "managed-explicit",
+                    "kind": "pi",
+                    "pane_id": pane_id,
+                    "command": {
+                        "executable": explicit.display().to_string(),
+                        "args": literal_args,
+                        "cwd": explicit_cwd.display().to_string(),
+                        "env": {"EXPLICIT_ENV": "literal value"}
+                    },
+                    "timeout_ms": 8_000
+                }
+            })
+            .to_string(),
+        );
+        if response["error"]["code"] != "agent_pane_busy" {
+            break response;
+        }
+        assert!(Instant::now() < deadline, "pane shell did not become ready");
+        thread::sleep(Duration::from_millis(25));
+    };
+    assert_eq!(started["result"]["type"], "agent_started", "{started}");
+    assert_eq!(started["result"]["argv"][0], explicit.display().to_string());
+
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let ready = loop {
+        let current = send_request(
+            &socket_path,
+            r#"{"id":"explicit_get","method":"agent.get","params":{"target":"managed-explicit"}}"#,
+        );
+        if current["result"]["agent"]["interactive_ready"] == true {
+            break current;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "explicit managed agent did not become ready: {current}"
+        );
+        thread::sleep(Duration::from_millis(25));
+    };
+    assert_eq!(ready["result"]["agent"]["agent"], "pi");
+    assert_ne!(ready["result"]["agent"]["launch_pending"], true);
+    assert!(!trap_record.exists(), "PATH-selected pi trap was invoked");
+    assert!(!explicit_cwd.join("should-not-exist").exists());
+
+    let recorded = fs::read_to_string(&record).unwrap();
+    assert!(recorded.contains(&format!("cwd=<{}>", explicit_cwd.display())));
+    assert!(recorded.contains("env=<literal value>"));
+    assert!(recorded.contains("managed-kind=<pi>"));
+    let size = recorded
+        .lines()
+        .find_map(|line| line.strip_prefix("size=<")?.strip_suffix('>'))
+        .expect("explicit agent should inherit a PTY size");
+    assert!(size
+        .split_ascii_whitespace()
+        .all(|value| value.parse::<u16>().is_ok_and(|value| value > 0)));
+    for expected in [
+        "arg[0]=<foo bar>",
+        "arg[1]=<'single' and \"double\">",
+        "arg[2]=<$(touch should-not-exist)>",
+        "arg[3]=<*.rs; echo not-a-command>",
+        "arg[4]=<snowman ☃>",
+        "arg[5]=<>",
+    ] {
+        assert!(
+            recorded.contains(expected),
+            "missing {expected:?} in {recorded:?}"
+        );
+    }
+
+    let prompted = send_request(
+        &socket_path,
+        r#"{"id":"explicit_prompt","method":"agent.prompt","params":{"target":"managed-explicit","text":"hello explicit"}}"#,
+    );
+    assert_eq!(prompted["result"]["type"], "agent_prompted", "{prompted}");
+    let deadline = Instant::now() + Duration::from_secs(2);
+    while !fs::read_to_string(&record)
+        .unwrap_or_default()
+        .contains("prompt=<hello explicit>")
+    {
+        assert!(
+            Instant::now() < deadline,
+            "prompt did not reach explicit managed agent"
+        );
+        thread::sleep(Duration::from_millis(25));
+    }
+
+    cleanup_spawned_herdr(child, base);
+}
