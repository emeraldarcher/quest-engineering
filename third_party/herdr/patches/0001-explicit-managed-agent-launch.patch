+#[test]
+fn explicit_launch_failure_is_typed_and_restores_the_pane_shell() {
+    let _lock = test_lock();
+    let base = unique_test_dir();
+    let config_home = base.join("config");
+    let runtime_dir = base.join("runtime");
+    let socket_path = runtime_dir.join("herdr.sock");
+    fs::create_dir_all(&base).unwrap();
+    let absolute_base = fs::canonicalize(&base).unwrap();
+    let shell_marker = absolute_base.join("shell-restored");
+    let missing = absolute_base.join("missing-explicit-agent");
+
+    let child = spawn_herdr(&config_home, &runtime_dir, &socket_path);
+    wait_for_socket(&socket_path, Duration::from_secs(5));
+    let workspace = send_request(
+        &socket_path,
+        &serde_json::json!({
+            "id": "failed_explicit_workspace",
+            "method": "workspace.create",
+            "params": { "cwd": absolute_base.display().to_string(), "focus": false }
+        })
+        .to_string(),
+    );
+    let pane_id = workspace["result"]["root_pane"]["pane_id"]
+        .as_str()
+        .unwrap()
+        .to_string();
+
+    let started = send_request(
+        &socket_path,
+        &serde_json::json!({
+            "id": "failed_explicit_start",
+            "method": "agent.start",
+            "params": {
+                "name": "failed-explicit",
+                "kind": "pi",
+                "pane_id": pane_id,
+                "command": {
+                    "executable": missing.display().to_string(),
+                    "args": [],
+                    "cwd": absolute_base.display().to_string()
+                },
+                "timeout_ms": 8_000
+            }
+        })
+        .to_string(),
+    );
+    assert_eq!(started["result"]["type"], "agent_started", "{started}");
+
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        let failure = send_request(
+            &socket_path,
+            &serde_json::json!({
+                "id": "failed_explicit_reconcile",
+                "method": "agent.start",
+                "params": {
+                    "name": "failed-explicit",
+                    "kind": "pi",
+                    "pane_id": pane_id,
+                    "timeout_ms": 8_000
+                }
+            })
+            .to_string(),
+        );
+        if failure["error"]["code"] == "agent_explicit_launch_failed" {
+            assert!(!failure["error"]["message"].as_str().unwrap().is_empty());
+            break;
+        }
+        assert!(
+            failure["error"]["code"] == "agent_name_taken"
+                || failure["error"]["code"] == "agent_pane_busy",
+            "unexpected launch reconciliation: {failure}"
+        );
+        assert!(Instant::now() < deadline, "launch failure stayed ambiguous");
+        thread::sleep(Duration::from_millis(25));
+    }
+
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        let sent = send_request(
+            &socket_path,
+            &serde_json::json!({
+                "id": "failed_explicit_shell_text",
+                "method": "pane.send_text",
+                "params": {
+                    "pane_id": pane_id,
+                    "text": format!("/usr/bin/touch {}", shell_marker.display())
+                }
+            })
+            .to_string(),
+        );
+        if sent["result"]["type"] == "ok" {
+            let entered = send_request(
+                &socket_path,
+                &serde_json::json!({
+                    "id": "failed_explicit_shell_enter",
+                    "method": "pane.send_keys",
+                    "params": {"pane_id": pane_id, "keys": ["Enter"]}
+                })
+                .to_string(),
+            );
+            assert_eq!(entered["result"]["type"], "ok", "{entered}");
+            break;
+        }
+        assert!(Instant::now() < deadline, "pane shell was not restored");
+        thread::sleep(Duration::from_millis(25));
+    }
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !shell_marker.exists() {
+        assert!(
+            Instant::now() < deadline,
+            "restored shell command did not run"
+        );
+        thread::sleep(Duration::from_millis(25));
+    }
+
+    cleanup_spawned_herdr(child, base);
+}
