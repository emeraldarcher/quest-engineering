+
+    pub(super) fn handle_explicit_agent_runtime_exit(
+        &mut self,
+        pane_id: crate::layout::PaneId,
+    ) -> bool {
+        let Some(state) = self.explicit_agent_launches.remove(&pane_id) else {
+            return false;
+        };
+        let ExplicitAgentLaunchState::WaitingForShellExit(pending) = state else {
+            let ExplicitAgentLaunchState::Running { name, .. } = state else {
+                unreachable!();
+            };
+            let launch_pending = self
+                .find_pane(pane_id)
+                .and_then(|(_, pane)| self.state.terminals.get(&pane.attached_terminal_id))
+                .is_some_and(|terminal| terminal.managed_agent_launch_pending());
+            if launch_pending {
+                self.explicit_agent_launch_failures.insert(
+                    pane_id,
+                    ExplicitAgentLaunchFailure {
+                        name,
+                        message:
+                            "explicit process exited before the expected managed agent became ready"
+                                .into(),
+                    },
+                );
+            }
+            return false;
+        };
+        let Some((ws_idx, pane)) = self.find_pane(pane_id) else {
+            return true;
+        };
+        let terminal_id = pane.attached_terminal_id.clone();
+        let Some(launch_env) = self.pane_launch_env(ws_idx, pane_id, pending.env) else {
+            self.record_explicit_launch_failure(
+                pane_id,
+                pending.name,
+                "pane launch identity became unavailable".into(),
+            );
+            return true;
+        };
+        let runtime = crate::terminal::TerminalRuntime::spawn_argv_command(
+            pane_id,
+            pending.rows,
+            pending.cols,
+            pending.cwd,
+            &pending.argv,
+            &launch_env,
+            crate::pane::AgentDetection::Enabled,
+            self.state.pane_scrollback_limit_bytes,
+            self.state.host_terminal_theme,
+            self.state.host_terminal_appearance,
+            self.event_tx.clone(),
+            self.render_notify.clone(),
+            self.render_dirty.clone(),
+        );
+        match runtime {
+            Ok(runtime) => {
+                self.terminal_runtimes.insert(terminal_id, runtime);
+                self.explicit_agent_launches.insert(
+                    pane_id,
+                    ExplicitAgentLaunchState::Running {
+                        name: pending.name,
+                        kind: pending.kind,
+                    },
+                );
+                self.state.mark_session_dirty();
+                self.schedule_session_save();
+            }
+            Err(err) => {
+                self.record_explicit_launch_failure(pane_id, pending.name, err.to_string());
+                let _ = self.respawn_shell_for_launch_pane(pane_id, true);
+            }
+        }
+        true
+    }
+
+    pub(super) fn explicit_agent_runtime_matches(
+        &self,
+        pane_id: crate::layout::PaneId,
+        expected: crate::detect::Agent,
+    ) -> bool {
+        matches!(
+            self.explicit_agent_launches.get(&pane_id),
+            Some(ExplicitAgentLaunchState::Running { kind, .. }) if *kind == expected
+        )
+    }
+
+    fn record_explicit_launch_failure(
+        &mut self,
+        pane_id: crate::layout::PaneId,
+        name: String,
+        message: String,
+    ) {
+        self.explicit_agent_launch_failures
+            .insert(pane_id, ExplicitAgentLaunchFailure { name, message });
+    }
+}
+
+struct ValidatedExplicitCommand {
+    argv: Vec<String>,
+    cwd: std::path::PathBuf,
+    env: Vec<(String, String)>,
+    rows: u16,
+    cols: u16,
+}
+
+fn validate_explicit_command(
+    command: AgentStartCommand,
+    terminal: &crate::terminal::TerminalState,
+    runtime: &crate::terminal::TerminalRuntime,
+    kind: crate::detect::Agent,
+) -> Result<ValidatedExplicitCommand, AgentStartError> {
+    let executable = std::path::Path::new(&command.executable);
+    if !executable.is_absolute() || command.executable.contains('\0') {
+        return Err(AgentStartError::InvalidExplicitCommand(
+            "explicit agent executable must be an absolute path without NUL bytes".into(),
+        ));
+    }
+    if command.args.iter().any(|arg| arg.contains('\0')) {
+        return Err(AgentStartError::InvalidExplicitCommand(
+            "explicit agent arguments cannot contain NUL bytes".into(),
+        ));
+    }
+    let cwd = match command.cwd {
+        Some(cwd) => {
+            let path = std::path::PathBuf::from(cwd);
+            if !path.is_absolute() {
+                return Err(AgentStartError::InvalidExplicitCommand(
+                    "explicit agent cwd must be an absolute path".into(),
+                ));
+            }
+            path
+        }
+        None => runtime
+            .foreground_cwd()
+            .or_else(|| runtime.cwd())
+            .unwrap_or_else(|| terminal.cwd.clone()),
+    };
+    let mut env = command.env.into_iter().collect::<Vec<_>>();
+    env.sort_by(|left, right| left.0.cmp(&right.0));
+    if env
+        .iter()
+        .any(|(key, value)| key.is_empty() || key.contains(['=', '\0']) || value.contains('\0'))
+    {
+        return Err(AgentStartError::InvalidExplicitCommand(
+            "explicit agent environment contains an invalid name or NUL byte".into(),
+        ));
+    }
+    env.retain(|(key, _)| key != "HERDR_AGENT");
+    env.push((
+        "HERDR_AGENT".into(),
+        crate::detect::interactive_agent_executable(kind).into(),
+    ));
+    let (rows, cols) = runtime.current_size();
+    let mut argv = Vec::with_capacity(command.args.len() + 1);
+    argv.push(command.executable);
+    argv.extend(command.args);
+    Ok(ValidatedExplicitCommand {
+        argv,
+        cwd,
+        env,
+        rows,
+        cols,
