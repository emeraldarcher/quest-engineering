{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quest Engineering",
  "version": "0.14.0",
  "identifier": "works.questengineering.client",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quest Engineering Town",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4000 ws://127.0.0.1:4000"
    }
  },
  "bundle": { "active": true, "targets": "all" }
}
